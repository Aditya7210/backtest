import streamlit as st


def _render_styles() -> None:
    st.markdown(
        """
<style>
.tut-hero {
  border: 1px solid #d6e4ff;
  background: linear-gradient(125deg, #f8fbff 0%, #eef7ff 100%);
  border-radius: 14px;
  padding: 18px 20px;
  margin-bottom: 14px;
}
.tut-hero h2 {
  margin: 0 0 6px 0;
  color: #1e3a8a;
  font-size: 1.35rem;
}
.tut-hero p {
  margin: 0;
  color: #334155;
  line-height: 1.5;
}
.tut-note {
  border-radius: 12px;
  padding: 11px 13px;
  margin: 8px 0 12px 0;
  border: 1px solid transparent;
}
.tut-note strong {
  display: block;
  margin-bottom: 2px;
}
.tut-info {
  background: #eff6ff;
  border-color: #bfdbfe;
}
.tut-ok {
  background: #ecfdf3;
  border-color: #86efac;
}
.tut-warn {
  background: #fff7ed;
  border-color: #fdba74;
}
.tut-risk {
  background: #fef2f2;
  border-color: #fecaca;
}
.tut-card {
  border: 1px solid #e2e8f0;
  border-radius: 12px;
  padding: 12px;
  margin-bottom: 10px;
  background: #ffffff;
}
.tut-card h4 {
  margin: 0 0 4px 0;
  color: #0f172a;
}
.tut-card p {
  margin: 0;
  color: #475569;
  line-height: 1.45;
}
</style>
""",
        unsafe_allow_html=True,
    )


def _note(title: str, message: str, tone: str = "info") -> None:
    st.markdown(
        f"""
<div class="tut-note tut-{tone}">
  <strong>{title}</strong>
  <span>{message}</span>
</div>
""",
        unsafe_allow_html=True,
    )


def render() -> None:
    _render_styles()

    st.markdown(
        """
<div class="tut-hero">
  <h2>Backtesting Tutorial</h2>
  <p>
    This is a beginner-friendly walkthrough of the full Backtesting workflow in this app,
    including how to select data, run strategies, and write strategy code using Backtrader fundamentals.
  </p>
</div>
""",
        unsafe_allow_html=True,
    )

    _note(
        "Start here",
        "If this is your first run, go to Zerodha Authentication first and complete login before using Zerodha API data mode.",
        "warn",
    )

    st.subheader("What each main tab means")
    st.markdown(
        """
<div class="tut-card"><h4>Documentation</h4><p>Technical system guide: architecture, lifecycle, limits, and reliability behavior from CODEBASE.md.</p></div>
<div class="tut-card"><h4>Tutorial</h4><p>Step-by-step usage guide (this page) for both beginners and advanced users.</p></div>
<div class="tut-card"><h4>Zerodha Authentication</h4><p>Connects and refreshes Kite credentials used for API data fetch and instrument search.</p></div>
<div class="tut-card"><h4>Dashboard</h4><p>Visual analytics section to inspect charts, indicators, and post-backtest outputs.</p></div>
<div class="tut-card"><h4>Backtests</h4><p>Main workspace for strategy editing, data source selection, execution config, and task execution.</p></div>
<div class="tut-card"><h4>Market Pulse</h4><p>Live-market related data collection and monitoring layer.</p></div>
""",
        unsafe_allow_html=True,
    )

    st.subheader("Backtests tab: what each panel does")
    st.markdown(
        """
1. **Strategy editor (left panel)**
   - Edit Python strategy code.
   - Save changes.
   - See unsaved/saved indicator.
2. **Data Source selector (top-right area)**
   - Choose one mode: Local CSV, Zerodha API, or Live Market.
3. **Data Selection expander**
   - Configure selected mode inputs.
   - CSV files, Zerodha symbol/interval/date queue, or live instrument selection.
4. **Strategy Selection expander**
   - Select strategy file and class.
5. **Versioning expander**
   - Optional automatic versioned save behavior.
6. **Execution Config expander**
   - Initial capital, commission, retries, and task timeout.
7. **Execute Strategy button**
   - Builds tasks and starts queue execution.
8. **Execution Terminal panel**
   - Real-time logs for progress, warnings, and failures.
"""
    )

    _note(
        "Important",
        "A task runs only when a valid strategy class is selected and the chosen data mode has complete input selection.",
        "risk",
    )

    st.subheader("Beginner workflow: run your first backtest")
    st.markdown(
        """
1. Open **Zerodha Authentication** and complete session setup (if using Zerodha data).
2. Open **Backtests**.
3. Select a strategy file and strategy class in **Strategy Selection**.
4. Choose **Data Source**:
   - Local CSV: select one or more files.
   - Zerodha API: choose symbol, interval, dates, and add to queue.
   - Live Market: select date/instrument/timeframe.
5. Set execution config:
   - Initial Capital
   - Commission
   - Max Retries
   - Task Timeout
6. Click **Execute Strategy**.
7. Watch progress bar + terminal logs.
8. Review final status and generated log/result file paths.
"""
    )

    st.subheader("Backtrader coding tutorial (Beginner)")
    _note(
        "Based on Backtrader Strategy lifecycle",
        "Use __init__ for indicators, next for trading decisions, and notify_order/notify_trade for execution events.",
        "info",
    )

    st.markdown("**Step 1: Create a simple SMA crossover strategy**")
    st.code(
        """import backtrader as bt

class SmaCrossStrategy(bt.Strategy):
    params = dict(fast_period=20, slow_period=50)

    def __init__(self):
        self.fast = bt.indicators.SimpleMovingAverage(self.data.close, period=self.p.fast_period)
        self.slow = bt.indicators.SimpleMovingAverage(self.data.close, period=self.p.slow_period)
        self.crossover = bt.indicators.CrossOver(self.fast, self.slow)

    def next(self):
        if not self.position and self.crossover > 0:
            self.buy()
        elif self.position and self.crossover < 0:
            self.close()
""",
        language="python",
    )

    st.markdown("**Step 2: Add order/trade notifications for visibility**")
    st.code(
        """def notify_order(self, order):
    if order.status in [order.Completed]:
        action = "BUY" if order.isbuy() else "SELL"
        self.log(f"{action} EXECUTED @ {order.executed.price}")


def notify_trade(self, trade):
    if trade.isclosed:
        self.log(f"TRADE PnL: gross={trade.pnl:.2f}, net={trade.pnlcomm:.2f}")


def log(self, txt):
    dt = self.datas[0].datetime.date(0)
    print(f"{dt.isoformat()} - {txt}")
""",
        language="python",
    )

    st.markdown("**Step 3: Save and run in Backtests tab**")
    st.markdown(
        """
- Save strategy.
- Select the strategy class in Strategy Selection.
- Select data source and execute.
- Confirm terminal shows order/trade updates.
"""
    )

    st.subheader("Backtrader coding tutorial (Advanced)")
    st.markdown(
        "Advanced users typically combine lifecycle control, order type selection, and risk logic with strict entry/exit conditions."
    )

    st.markdown("**Advanced pattern: parameterized strategy with risk controls**")
    st.code(
        """import backtrader as bt

class TrendPullbackStrategy(bt.Strategy):
    params = dict(
        sma_period=50,
        atr_period=14,
        risk_per_trade=0.01,
        stop_atr=1.5,
        take_profit_atr=3.0,
    )

    def __init__(self):
        self.sma = bt.indicators.SimpleMovingAverage(self.data.close, period=self.p.sma_period)
        self.atr = bt.indicators.ATR(self.data, period=self.p.atr_period)
        self.entry_order = None

    def next(self):
        if self.entry_order:
            return

        if not self.position and self.data.close[0] > self.sma[0]:
            cash = self.broker.getcash()
            stop_distance = self.atr[0] * self.p.stop_atr
            size = max(1, int((cash * self.p.risk_per_trade) / max(stop_distance, 0.01)))
            self.entry_order = self.buy(size=size)

        elif self.position and self.data.close[0] < self.sma[0]:
            self.close()

    def notify_order(self, order):
        if order.status in [order.Completed, order.Canceled, order.Margin, order.Rejected]:
            self.entry_order = None
""",
        language="python",
    )

    _note(
        "Order APIs you should know (from Backtrader guide)",
        "buy(), sell(), close(), cancel(), notify_order(), notify_trade(), start(), prenext(), nextstart(), next(), stop() are core lifecycle methods you will use repeatedly.",
        "ok",
    )

    st.subheader("How to teach strategy coding to your own users")
    st.markdown(
        """
### Beginner track
1. Start with one indicator + one rule strategy.
2. Explain only 3 methods first: `__init__`, `next`, `notify_order`.
3. Use small datasets and short date ranges for fast feedback.
4. Ask users to verify one behavior at a time (entry, then exit, then PnL).

### Advanced track
1. Introduce parameterized strategies (`params`) and explain tuning safely.
2. Add risk-based sizing and strict stop/exit logic.
3. Add strategy logging conventions for observability.
4. Compare outputs across multiple symbols and timeframes for robustness.
"""
    )

    _note(
        "Best practice",
        "Keep strategy code deterministic: avoid random behavior and hidden global state so results remain reproducible.",
        "info",
    )
