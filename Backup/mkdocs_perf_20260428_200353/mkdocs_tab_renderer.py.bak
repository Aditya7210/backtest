from __future__ import annotations

import base64
import mimetypes
import re
import subprocess
import sys
import tempfile
from pathlib import Path

import streamlit as st
import streamlit.components.v1 as components


_PROJECT_ROOT = Path(__file__).resolve().parents[1]
_PORTAL_ROOT = _PROJECT_ROOT / "Dashboard" / "mkdocs_portal"
_MKDOCS_CONFIG = _PORTAL_ROOT / "mkdocs.yml"
_SITE_DIR = _PORTAL_ROOT / "site"


def _run_mkdocs_build(config_path: Path) -> subprocess.CompletedProcess[str]:
    command = [
        sys.executable,
        "-m",
        "mkdocs",
        "build",
        "-f",
        str(config_path),
        "--clean",
        "--site-dir",
        str(_SITE_DIR),
    ]
    return subprocess.run(
        command,
        cwd=str(_PORTAL_ROOT),
        capture_output=True,
        text=True,
        check=False,
    )


def _portal_build_signature() -> str:
    tracked_files = [_MKDOCS_CONFIG]
    docs_dir = _PORTAL_ROOT / "docs"
    tracked_files.extend(sorted(docs_dir.glob("*.md")))

    parts: list[str] = []
    for path in tracked_files:
        if path.exists():
            stat = path.stat()
            parts.append(f"{path.name}:{stat.st_mtime_ns}:{stat.st_size}")
    return "|".join(parts)


def _ensure_mkdocs_build() -> None:
    if not _MKDOCS_CONFIG.exists():
        raise FileNotFoundError(f"MkDocs config missing: {_MKDOCS_CONFIG}")

    current_sig = _portal_build_signature()
    cache_key = "_mkdocs_portal_build_sig"
    built_sig = st.session_state.get(cache_key)

    if _SITE_DIR.exists() and built_sig == current_sig:
        return

    _SITE_DIR.mkdir(parents=True, exist_ok=True)
    run_result = _run_mkdocs_build(_MKDOCS_CONFIG)

    if run_result.returncode != 0:
        err_blob = f"{run_result.stdout or ''}\n{run_result.stderr or ''}".lower()
        if "material" in err_blob and ("no module named" in err_blob or "theme" in err_blob):
            fallback_yaml = """site_name: Algo Trading System Docs
docs_dir: docs
theme:
  name: mkdocs
nav:
  - Documentation: documentation.md
  - Tutorial: tutorial.md
markdown_extensions:
  - admonition
  - attr_list
  - tables
  - toc:
      permalink: true
"""
            with tempfile.NamedTemporaryFile(
                mode="w",
                suffix=".yml",
                dir=str(_PORTAL_ROOT),
                delete=False,
                encoding="utf-8",
            ) as temp_cfg:
                temp_cfg.write(fallback_yaml)
                fallback_path = Path(temp_cfg.name)
            try:
                run_result = _run_mkdocs_build(fallback_path)
            finally:
                try:
                    fallback_path.unlink(missing_ok=True)
                except Exception:
                    pass

    if run_result.returncode != 0:
        stderr = (run_result.stderr or "").strip()
        stdout = (run_result.stdout or "").strip()
        details = stderr or stdout or "unknown mkdocs build error"
        raise RuntimeError(f"MkDocs build failed: {details}")

    st.session_state[cache_key] = current_sig


def _resolve_asset_path(raw_ref: str, *, base_dir: Path) -> Path:
    clean_ref = raw_ref.split("?", 1)[0].split("#", 1)[0].strip()
    if clean_ref.startswith("/"):
        return (_SITE_DIR / clean_ref.lstrip("/")).resolve()
    return (base_dir / clean_ref).resolve()


def _rewrite_css_urls(css_text: str, css_file: Path) -> str:
    url_pattern = re.compile(r"url\(([^)]+)\)")

    def _replace(match: re.Match[str]) -> str:
        raw_value = match.group(1).strip().strip('"\'')
        if not raw_value or raw_value.startswith(("data:", "http://", "https://", "#")):
            return match.group(0)

        target_path = _resolve_asset_path(raw_value, base_dir=css_file.parent)
        if not target_path.exists() or not target_path.is_file():
            return match.group(0)

        try:
            binary = target_path.read_bytes()
        except Exception:
            return match.group(0)

        mime_type, _ = mimetypes.guess_type(str(target_path))
        mime = mime_type or "application/octet-stream"
        encoded = base64.b64encode(binary).decode("ascii")
        return f'url("data:{mime};base64,{encoded}")'

    return url_pattern.sub(_replace, css_text)


def _inline_styles_from_html(html: str, *, page_path: Path) -> str:
    link_pattern = re.compile(
        r'<link[^>]+rel=["\']stylesheet["\'][^>]+href=["\']([^"\']+)["\'][^>]*>',
        re.IGNORECASE,
    )

    css_chunks: list[str] = []
    for href in link_pattern.findall(html):
        if href.startswith(("http://", "https://", "//")):
            css_chunks.append(f'@import url("{href}");')
            continue

        css_path = _resolve_asset_path(href, base_dir=page_path.parent)
        if css_path.exists() and css_path.is_file():
            css_text = css_path.read_text(encoding="utf-8", errors="replace")
            css_chunks.append(_rewrite_css_urls(css_text, css_path))

    return "\n\n".join(css_chunks)


def _extract_main_content(html: str) -> str:
    article_match = re.search(r"<article[\s\S]*?</article>", html, re.IGNORECASE)
    if article_match:
        return article_match.group(0)

    main_match = re.search(r"<main[\s\S]*?</main>", html, re.IGNORECASE)
    if main_match:
        return main_match.group(0)

    body_match = re.search(r"<body[^>]*>([\s\S]*?)</body>", html, re.IGNORECASE)
    if body_match:
        return body_match.group(1)

    return html


def _extract_body_attributes(html: str) -> str:
    body_open = re.search(r"<body([^>]*)>", html, re.IGNORECASE)
    if not body_open:
        return ""
    return (body_open.group(1) or "").strip()


def render_mkdocs_page(relative_page: str, *, height: int = 1250) -> None:
    _ensure_mkdocs_build()

    page_path = (_SITE_DIR / relative_page).resolve()
    if not page_path.exists():
        raise FileNotFoundError(f"Rendered MkDocs page not found: {page_path}")

    html = page_path.read_text(encoding="utf-8", errors="replace")
    css_bundle = _inline_styles_from_html(html, page_path=page_path)
    main_html = _extract_main_content(html)
    body_attrs = _extract_body_attributes(html)

    packaged_html = f"""
<!doctype html>
<html>
  <head>
    <meta charset=\"utf-8\" />
    <style>
      html, body {{
        margin: 0;
        padding: 0;
        background: #ffffff;
      }}
      {css_bundle}
      .portal-layout {{
        display: grid;
        grid-template-columns: 260px minmax(0, 1fr);
        gap: 20px;
        max-width: 1400px;
        margin: 0 auto;
        padding: 8px 12px 20px 12px;
        box-sizing: border-box;
      }}
      .portal-mini-nav {{
        position: sticky;
        top: 10px;
        align-self: start;
        border: 1px solid #e2e8f0;
        background: #fbfdff;
        border-radius: 12px;
        padding: 12px;
        max-height: calc(100vh - 24px);
        overflow: auto;
      }}
      .portal-mini-nav-title {{
        font-size: 0.82rem;
        font-weight: 700;
        text-transform: uppercase;
        color: #1e40af;
        margin-bottom: 8px;
        letter-spacing: 0.03em;
      }}
      .portal-mini-nav ul {{
        list-style: none;
        margin: 0;
        padding: 0;
      }}
      .portal-mini-nav li {{
        margin: 0 0 5px 0;
      }}
      .portal-mini-nav li.h3 {{
        margin-left: 12px;
      }}
      .portal-mini-nav a {{
        display: block;
        text-decoration: none;
        color: #334155;
        font-size: 0.88rem;
        line-height: 1.4;
        border-radius: 8px;
        padding: 5px 7px;
      }}
      .portal-mini-nav a:hover {{
        background: #eff6ff;
        color: #1d4ed8;
      }}
      #portal-main h1,
      #portal-main h2,
      #portal-main h3,
      #portal-main h4 {{
        scroll-margin-top: 8px;
      }}
      .md-main__inner {{
        margin: 0 auto;
        max-width: 1280px;
      }}
      .md-content {{
        margin: 0 auto;
        width: 100%;
      }}
      .md-content__inner {{
        margin-top: 0.4rem;
      }}
      .md-sidebar,
      .md-tabs,
      .md-header,
      .md-footer,
      .md-source,
      .md-nav,
      .md-top {{
        display: none !important;
      }}
      .md-main {{
        margin: 0;
      }}
      .md-grid {{
        max-width: 1280px;
      }}
      @media (max-width: 1120px) {{
        .portal-layout {{
          grid-template-columns: 1fr;
          padding-left: 4px;
          padding-right: 4px;
        }}
        .portal-mini-nav {{
          position: static;
          max-height: none;
        }}
      }}
    </style>
  </head>
  <body {body_attrs}>
    <div class="portal-layout">
      <aside class="portal-mini-nav" id="portal-mini-nav">
        <div class="portal-mini-nav-title">On This Page</div>
        <ul id="portal-mini-nav-list"></ul>
      </aside>
      <section id="portal-main">
        {main_html}
      </section>
    </div>
    <script>
      (function() {{
        function slugify(text) {{
          return (text || "")
            .toLowerCase()
            .replace(/[^a-z0-9\\s-]/g, "")
            .trim()
            .replace(/\\s+/g, "-")
            .replace(/-+/g, "-");
        }}

        const navList = document.getElementById("portal-mini-nav-list");
        const navBox = document.getElementById("portal-mini-nav");
        if (!navList || !navBox) return;

        const headings = Array.from(
          document.querySelectorAll("#portal-main .md-content h2, #portal-main .md-content h3")
        );
        const fallback = Array.from(
          document.querySelectorAll("#portal-main .md-content h1, #portal-main .md-content h2")
        );
        const source = headings.length > 0 ? headings : fallback;

        if (source.length < 2) {{
          navBox.style.display = "none";
          return;
        }}

        const seen = new Map();
        source.forEach((heading) => {{
          let id = heading.getAttribute("id");
          const cleanText = (heading.textContent || "").replace("¶", "").trim();
          if (!id) {{
            const base = slugify(cleanText) || "section";
            const count = (seen.get(base) || 0) + 1;
            seen.set(base, count);
            id = count === 1 ? base : `${{base}}-${{count}}`;
            heading.setAttribute("id", id);
          }}

          const li = document.createElement("li");
          li.className = heading.tagName.toLowerCase();
          const a = document.createElement("a");
          a.href = `#${{id}}`;
          a.textContent = cleanText || id;
          li.appendChild(a);
          navList.appendChild(li);
        }});

        document.addEventListener("click", (event) => {{
          const anchor = event.target && event.target.closest ? event.target.closest("a") : null;
          if (!anchor) return;
          const href = (anchor.getAttribute("href") || "").trim();
          if (!href) return;

          if (href.startsWith("#")) {{
            return;
          }}

          event.preventDefault();
          if (/^https?:\\/\\//i.test(href)) {{
            window.open(href, "_blank", "noopener,noreferrer");
          }}
        }});
      }})();
    </script>
  </body>
</html>
"""

    components.html(packaged_html, height=height, scrolling=True)
