# Zerodha API credentials (rotate before first Docker deployment)
ZERODHA_API_KEY=your_api_key_here
ZERODHA_API_SECRET=your_api_secret_here
ZERODHA_ACCESS_TOKEN=your_access_token_here
ZERODHA_TOKEN_DATE=2026-01-01

# MongoDB (hostname 'mongodb' resolves inside Docker Compose network)
MONGO_URI=mongodb://mongodb:27017/algo_trading

# Backtesting
BACKTEST_WORKER_COUNT=1
TASK_STORE_PATH=/app/data/task_store.json

# CORS (dev only — in production nginx proxies same-origin)
CORS_ORIGINS=http://localhost:5173
ENV_FILE_PATH=.env

# Live Market collector config
LM_EQUITY_UNIVERSE=NIFTY500_PLUS_FNO
LM_OPTION_EXPIRY_COUNT=1
LM_STRIKES_AROUND_ATM=0
LM_COLLECT_EQUITIES=true
LM_COLLECT_OPTIONS=true
LM_COLLECT_VIX=true
LM_COLLECT_INDEX_SPOT_TOKENS=true
